<%- layout("layout/boilerplate") %><!--ejsmate for showing the same content we want o evry page -->
<script>
    const map_token="<%=process.env.MAP_API_KEY%>";
    const coordinates= <%-JSON.stringify(datalist.geometry.coordinates)%>;
</script>
<div class="row show-card" >
    <div class="col-8 offset-2">
        <h5 class="card-title"><%= datalist.title %></h5>
    <div class="card">
        <div class="row show-card" >
        <div class="col-8 offset-1">
        <img src="<%=datalist.image.url%>" class="card-img-top" alt="listing-img" >
        </div>
        </div>
        <div class="card-body">
            <p class="card-text"><Strong >Owned By </Strong><i style="text-decoration: underline;"><%= datalist.owner.username %> </i><br>
            <p class="card-text"><%= datalist.description %> <br>
            <p class="card-text">&#x20B9;<%= datalist.price.toLocaleString("en-IN") %></p><!--toLocaleString("en-IN") FOR PRICING COMMAS --> 
            <p class="card-text"><%= datalist.location %></p>
            <p class="card-text"><%= datalist.country %></p>
        </p>
        </div>
      </div>
      <% if (currUser && datalist.owner._id.equals(currUser._id)) { %>
    <a href="/listings/<%= datalist._id %>/edit" class="btn btn-dark">Edit Listing</a>
        <br><br>
        <form method="post"action="/listings/<%=datalist.id%>?_method=DELETE">
            <button class="btn btn-dark">Delete listing</button>
        </form> 
    <%}%>
    </div>
    <% if (currUser) { %>
    <div class="row">
    <div class="col-8 offset-2">
        <hr> 
        <div class="col-8 offset-2">
            
            <h4 style="margin: 2rem; text-align: center; text-decoration:underline;">Leave a review</h4>
        </div>
    
        <form action="/listings/<%=datalist._id%>/review" method="post" novalidate class="needs-validation" >
            <!-- <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5"  id="rating" name="review[rating]" class="form-range" >
            </div> -->
            <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-coinFlip">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div class="mb-3"> 
                <label for="comment" class="form-label">Leave a feedback</label>
                <textarea name="review[Comment]" id="Comment" class="form-control" rows="3" cols="10" required></textarea >
                    <div class="invalid-feedback">
                        Please enter a comment!
                      </div>
            </div>
            <button type="submit" class="btn btn-dark">Submit</button>
    
        </form>
    </div>
   </div>
   <%}%>     

<div class="mb-3">
    <% if(datalist.reviews.length>0){%>
        <hr>
        <h2>Reviews</h2>
        <% for (let review of datalist.reviews) { %>
        <div class="review mb-3 p-3 border rounded">
            <h6 class="card-subtitle mb-2 text-body-secondary">
                <%= review.author ? review.author.username : "Anonymous" %>
            </h6>
            <p><strong>Rating:</strong> <%= review.rating %>/5</p>
            <p class="starability-result" data-rating="<%= review.rating %>">
                Rated: 3 stars
              </p>
            <p><strong>Comment:</strong> <%= review.Comment %></p>
            <% if (currUser && review.author._id.equals(currUser._id)) { %>
            <form method="post"  action="/listings/<%=datalist._id%>/review/<%=review._id%>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
            </form>
            <%}%>
        </div>
        <%}%>
    <% } %>
</div>


<div class="mb-3 col-8 offset-2">
    <h3>Where you will be!</h3>
    <div id="map"></div>
</div>
</div>


<script src="/js/map.js"></script>