<% layout("layout/boilerplate") %>

<!-- <h3>All listings</h3> -->
<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
    margin-left: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 1.5rem;
    opacity: 0.7;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
    text-decoration: underline;
  } 
  .filter p{
    font-size: small;
  }
  .tax_toggle{
    border: 0.7px solid grey;
    border-radius: 1rem;
    height: 3.5rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    margin-left: 6rem;
  }
  .tax_info{
    display: none;
  }
  
</style>
  <div id="filters" class="mb-3 mt-2">
    
      <div class="filter">
        <div><i class="fa-solid fa-bolt-lightning"></i></div>
        <p>Trending</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></i></div>
        <p>Pools</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-tent"></i></div>
        
        <p>Camping</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-snowman"></i></div>
        <p>Polar paradise</p>
    </div>
    <div class="tax_toggle">
      <div class="form-check-reverse form-switch mt-3">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Include taxes</label>
      </div>
    </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
  <% for (let listing of listingdata) { %>
    
    <a href="/listings/<%= listing._id %>" class="listing text-decoration-none text-dark">
      <div class="card col m-3" style="width: 20rem;">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem; object-fit: cover;">
        <div class="card-body">
          <h5 class="card-title"><%= listing.title %></h5>
          <p class="card-text">&#x20B9;<%= listing.price.toLocaleString("en-IN") %> /night <i class="tax_info"> &nbsp;+18% GST </i></p>
          
          <p class="card-text"><%= listing.description %></p>
        </div>
      </div>
    </a>
  <% } %>

</div>


<script>
  let toggle=document.getElementById("switchCheckDefault");
  toggle.addEventListener("click",()=>{
      let taxinfo=document.getElementsByClassName("tax_info");
      for(info of taxinfo){
        if(info.style.display=="inline"){
          info.style.display="none";
        }
        else{
          info.style.display="inline";
        }
      }
  })
</script>